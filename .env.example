# Copy this file to ".env" and fill in the values. .env is git-ignored and never leaves your machine.
# In GitHub Actions these same names come from repository secrets instead.

# SAM.gov (US federal). Key from https://sam.gov/workspace/profile/account-details ("Public API Key").
# NOTE: keys rotate roughly every 90 days — SAM emails reminders. Update this value when it changes.
SAM_API_KEY=

# Bulk CSV download URL from SAM.gov > Data Services > Contract Opportunities.
# Leave blank to let the ingester try its default path.
SAM_BULK_CSV_URL=

# Optional overrides — all discovered automatically when blank.
AUSTENDER_RSS_URL=
CANADABUYS_CSV_URL=
